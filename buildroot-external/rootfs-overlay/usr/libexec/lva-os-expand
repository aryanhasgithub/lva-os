#!/bin/sh
# ==============================================================================
# LVA OS Partition Expander
# ==============================================================================
set -e

# Target label matching your genimage.cfg partition tree block
TARGET_LABEL="lvaos-data"
CONFIG_LABEL="CONFIG"

DEVICE_CHILD="$(findfs LABEL="${TARGET_LABEL}")"
DEVICE_CHILD_NAME="$(basename "${DEVICE_CHILD}")"
DEVICE_ROOT_NAME="$(lsblk -no pkname "${DEVICE_CHILD}")"
DEVICE_ROOT="/dev/${DEVICE_ROOT_NAME}"
PART_NUM="$(cat "/sys/class/block/${DEVICE_CHILD_NAME}/partition")"

# Get partition label type
PART_TABLE="$(sfdisk -lqJ "${DEVICE_ROOT}")"
PART_LABEL="$(echo "${PART_TABLE}" | jq -r '.partitiontable.label')"
echo "[INFO] Checking if expanding data partition on ${DEVICE_CHILD} is necessary"

if [ "${PART_LABEL}" = "gpt" ]; then
    echo "[INFO] Detected GPT partition label on ${DEVICE_ROOT}"

    # Critical for your GPT layout: Fixes the backup table placement when flashed onto larger SD cards
    if sfdisk --verify "${DEVICE_ROOT}" 2>&1 | grep "The backup GPT table is not on the end of the device."; then
        echo "[INFO] Moving GPT backup header to the absolute end of the physical disk"
        sfdisk --relocate gpt-bak-std "${DEVICE_ROOT}"

        # Reload partition label to accurately grab the updated .partitiontable.lastlba
        PART_TABLE="$(sfdisk -lqJ "${DEVICE_ROOT}")"
    fi
    LAST_USABLE_LBA="$(echo "${PART_TABLE}" | jq -r '.partitiontable.lastlba')"
else
    echo "[INFO] Detected MBR partition label on ${DEVICE_ROOT}"

    # Fallback calculation if utilizing an MBR container schema
    DEVICE_SIZE=$(blockdev --getsize64 "${DEVICE_ROOT}")
    LAST_USABLE_LBA=$(echo "${PART_TABLE}" | jq -r "${DEVICE_SIZE} / .partitiontable.sectorsize")
fi
echo "[INFO] Last usable logical block ${LAST_USABLE_LBA}"

# Calculate end of your custom data partition
JQ_FILTER=".partitiontable.partitions[] | select ( .node == \"${DEVICE_CHILD}\" ) | .start + .size"
DATA_PARTITION_END="$(echo "${PART_TABLE}" | jq "${JQ_FILTER}")"
echo "[INFO] LVA Data partition end block ${DATA_PARTITION_END}"

# The CONFIG partition (written by lva-installer) is anchored to the end of
# the disk, after lvaos-data. If present, lvaos-data must not be grown past
# it. Fall back to LAST_USABLE_LBA if CONFIG doesn't exist (e.g. dev image
# flashed without the installer's CONFIG step).
JQ_CONFIG_FILTER=".partitiontable.partitions[] | select ( .name == \"${CONFIG_LABEL}\" ) | .start"
CONFIG_START="$(echo "${PART_TABLE}" | jq -r "${JQ_CONFIG_FILTER}")"

if [ -n "${CONFIG_START}" ] && [ "${CONFIG_START}" != "null" ]; then
    echo "[INFO] Detected ${CONFIG_LABEL} partition at block ${CONFIG_START} — capping growth ceiling there"
    GROWTH_CEILING=$(( CONFIG_START - 1 ))
else
    GROWTH_CEILING="${LAST_USABLE_LBA}"
fi

# Reserve ~100MB of unallocated space between lvaos-data and the growth ceiling
# (100 * 1024 * 1024 / 512 = 204800 sectors at 512b sector size)
RESERVE_SECTORS=204800

# Need resize? Ignore free space if it is less than 8MB/64MB (16384 sectors at 512b)
# to completely prevent rounding loop overflows or partition alignment drift.
UNUSED_BLOCKS=$(( GROWTH_CEILING - DATA_PARTITION_END ))
if [ "${UNUSED_BLOCKS}" -le "16384" ]; then
    echo "[INFO] No resize of data partition needed"
    exit 0
fi

# Get current start sector of the target partition so we can compute an explicit new size
JQ_START_FILTER=".partitiontable.partitions[] | select ( .node == \"${DEVICE_CHILD}\" ) | .start"
DATA_PARTITION_START="$(echo "${PART_TABLE}" | jq "${JQ_START_FILTER}")"

NEW_SIZE=$(( GROWTH_CEILING - DATA_PARTITION_START - RESERVE_SECTORS ))

if [ "${NEW_SIZE}" -le "0" ]; then
    echo "[INFO] Not enough free space to grow after reserving buffer"
    exit 0
fi

echo "[INFO] Updating ${TARGET_LABEL} partition on position ${PART_NUM}"
echo "[INFO] New size for ${TARGET_LABEL}: ${NEW_SIZE} sectors (reserving ${RESERVE_SECTORS} sectors / ~100MB, ceiling ${GROWTH_CEILING})"
echo ",${NEW_SIZE}" | sfdisk --no-reread --no-tell-kernel -N "${PART_NUM}" "${DEVICE_ROOT}"
sfdisk -V "${DEVICE_ROOT}"

# Atomically update the active kernel's partition structure mapping
partx -u "${DEVICE_ROOT}"
udevadm settle

# Eliminates the race condition with systemd mnt-data.mount blocks by verifying
# that the hardware disk node state registers completely active before letting the script exit
if ! systemctl start "dev-disk-by\\x2dlabel-lvaos\\x2ddata.device"; then
    echo "[ERROR] LVA Data partition device node not found!"
    exit 1
fi

echo "[INFO] Finished lvaos-data partition resizing successfully"