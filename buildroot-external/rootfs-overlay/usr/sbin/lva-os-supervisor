#!/bin/sh
# shellcheck disable=SC1091
# ==============================================================================
# LVA OS Supervisor start script 
# ==============================================================================
set -e

# Load OS release info — provides BOARD_ID
. /usr/lib/os-release

# Paths
SUPERVISOR_DATA=/mnt/data/lva-supervisor
PORTAL_DATA=/mnt/data/lva-portal
SUPERVISOR_STARTUP_MARKER="${SUPERVISOR_DATA}/supervisor-started"
SUPERVISOR_CIDFILE="${SUPERVISOR_DATA}/lva-supervisor.cid"
SUPERVISOR_STARTSCRIPT_VERSION="/mnt/data/.lva-supervisor-version"
SUPERVISOR_IMAGE="ghcr.io/aryanhasgithub/lva-supervisor"


mkdir -p "${SUPERVISOR_DATA}"
mkdir -p "${PORTAL_DATA}"

rm -rf /run/lva/supervisor.sock
touch /run/lva/supervisor.sock

touch /mnt/data/lva-portal/master.env


SUPERVISOR_IMAGE_ID=$(docker images --no-trunc --filter "reference=${SUPERVISOR_IMAGE}:latest" --format "{{.ID}}" || echo "")
SUPERVISOR_CONTAINER_ID=$(docker inspect --format='{{.Image}}' lva-supervisor || echo "")

# Check if previous run left the startup marker in place.
# If so, assume corruption — delete container and images, pull fresh.
if [ -f "${SUPERVISOR_STARTUP_MARKER}" ]; then
    echo "[WARNING] Supervisor did not remove startup marker. Assuming corruption."
    docker container rm --force lva-supervisor || true
    SUPERVISOR_CONTAINER_ID=""

    SUPERVISOR_IMAGE_IDS=$(docker images --no-trunc --filter "reference=${SUPERVISOR_IMAGE}" --format "{{.ID}}" | sort | uniq || echo "")
    # shellcheck disable=SC2086
    docker image rm --force ${SUPERVISOR_IMAGE_IDS} || true
    SUPERVISOR_IMAGE_ID=""
fi

# SUPERVISOR_DATA is already created above, so this directory always
# exists — kept for safety in case that ordering ever changes.
mkdir -p "$(dirname "${SUPERVISOR_STARTUP_MARKER}")"
touch "${SUPERVISOR_STARTUP_MARKER}"

# If supervisor image is missing, pull it
if [ -z "${SUPERVISOR_IMAGE_ID}" ]; then
    SUPERVISOR_VERSION="latest"

    if [ "${SUPERVISOR_VERSION}" = "latest" ]; then
        SUPERVISOR_VERSION="$(curl -s --location https://raw.githubusercontent.com/aryanhasgithub/lva-version/main/stable.json | jq -e -r '.["lva-supervisor"]' || echo "latest")"
    fi

    echo "[WARNING] Supervisor image missing, downloading: ${SUPERVISOR_VERSION}"

    if docker pull "${SUPERVISOR_IMAGE}:${SUPERVISOR_VERSION}"; then
        docker tag "${SUPERVISOR_IMAGE}:${SUPERVISOR_VERSION}" "${SUPERVISOR_IMAGE}:latest"
    else
        echo "[ERROR] Supervisor download failed."
        exit 1
    fi

    SUPERVISOR_IMAGE_ID=$(docker inspect --format='{{.Id}}' "${SUPERVISOR_IMAGE}" || echo "")
fi

if [ -n "${SUPERVISOR_CONTAINER_ID}" ]; then
    if [ "${SUPERVISOR_IMAGE_ID}" != "${SUPERVISOR_CONTAINER_ID}" ]; then
        echo "[INFO] Supervisor image updated, destroying previous container..."
        docker container rm --force lva-supervisor || true
        SUPERVISOR_CONTAINER_ID=""
    fi

    # shellcheck disable=SC3013
    if [ ! -f "${SUPERVISOR_STARTSCRIPT_VERSION}" ] || [ "${SUPERVISOR_STARTSCRIPT_VERSION}" -nt "$0" ] || [ "${SUPERVISOR_STARTSCRIPT_VERSION}" -ot "$0" ]; then
        echo "[INFO] Supervisor start script changed, destroying previous container..."
        docker container rm --force lva-supervisor || true
        SUPERVISOR_CONTAINER_ID=""
    fi
fi

# Create container if missing
if [ -z "${SUPERVISOR_CONTAINER_ID}" ]; then
    [ -f "${SUPERVISOR_CIDFILE}" ] && rm -f "${SUPERVISOR_CIDFILE}"

    echo "[INFO] Creating new Supervisor container..."
    docker container create \
        --name lva-supervisor \
        --privileged --security-opt apparmor="lva-supervisor" \
        --oom-score-adj=-300 \
        --cidfile "${SUPERVISOR_CIDFILE}" \
        --mount type=bind,src="${SUPERVISOR_CIDFILE}",dst=/run/cid,readonly \
        -v /var/run/docker.sock:/var/run/docker.sock:rw \
        -v /run/lva:/run/lva:rw \
        -v /run/dbus:/run/dbus:ro \
        -v /etc/lva:/etc/lva:ro \
        -v "${SUPERVISOR_DATA}":/data:rw,slave \
        -p 8080:8080 \
        -e LVA_MACHINE="${BOARD_ID}" \
        "${SUPERVISOR_IMAGE}:latest"

    touch --reference="$0" "${SUPERVISOR_STARTSCRIPT_VERSION}"
fi

echo "[INFO] Starting the Supervisor..."
docker container start lva-supervisor
exec docker container wait lva-supervisor