[Unit]
Description=lva-os data partition
Wants=lva-os-expand.service
DefaultDependencies=no
After=lva-os-expand.service
Before=umount.target local-fs.target
Conflicts=umount.target
After=systemd-fsck@dev-disk-by\x2dlabel-lvaos\x2ddata.service
Wants=systemd-fsck@dev-disk-by\x2dlabel-lvaos\x2ddata.service systemd-growfs@mnt-data.service

[Mount]
What=/dev/disk/by-label/lvaos-data
Where=/mnt/data
Type=ext4
Options=commit=30

[Install]
WantedBy=local-fs.target