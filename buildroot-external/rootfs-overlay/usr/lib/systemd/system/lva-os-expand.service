[Unit]
Description=lva-os data resizing
DefaultDependencies=no
Before=mnt-data.mount
RefuseManualStart=true
RefuseManualStop=true
Requires=dev-disk-by\x2dlabel-lvaos\x2ddata.device
After=dev-disk-by\x2dlabel-lvaos\x2ddata.device systemd-fsck@dev-disk-by\x2dlabel-lvaos\x2ddata.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/lva-os-expand

[Install]
WantedBy=local-fs.target